{
  "family": "anb-worker-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/LabRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/LabRole",
  "containerDefinitions": [
    {
      "name": "anb-worker",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/anb-rising-stars-api:latest",
      "essential": true,
      "command": [
        "python",
        "-m",
        "app.workers.sqs_worker"
      ],
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql://anb_admin:PASSWORD@RDS_ENDPOINT:5432/anb_db"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "RDS_ENDPOINT"
        },
        {
          "name": "POSTGRES_PORT",
          "value": "5432"
        },
        {
          "name": "POSTGRES_USER",
          "value": "anb_admin"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "PASSWORD"
        },
        {
          "name": "POSTGRES_DB",
          "value": "anb_db"
        },
        {
          "name": "SQS_QUEUE_URL",
          "value": "https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/anb-video-processing-queue"
        },
        {
          "name": "SQS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "STORAGE_TYPE",
          "value": "cloud"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "anb-rising-stars-videos-east1"
        },
        {
          "name": "S3_UPLOAD_PREFIX",
          "value": "uploads/"
        },
        {
          "name": "S3_PROCESSED_PREFIX",
          "value": "processed_videos/"
        },
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "DEBUG",
          "value": "False"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/anb-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}

